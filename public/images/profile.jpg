<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6B8E23;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8AB84F;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#grad)"/>
  <circle cx="200" cy="150" r="80" fill="#FFFFFF" opacity="0.1"/>
  <rect x="0" y="250" width="400" height="250" fill="#FFFFFF" opacity="0.05"/>
  <text x="200" y="260" font-family="Arial" font-size="24" fill="#FFFFFF" text-anchor="middle" opacity="0.3">Your Portrait Here</text>
</svg>
