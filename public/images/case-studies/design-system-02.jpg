<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <rect width="600" height="400" fill="#FFFFFF"/>
  <text x="300" y="30" font-family="Arial" font-size="16" fill="#4D4D4D" text-anchor="middle" font-weight="bold">Color Palette &amp; Tokens</text>
  <g>
    <rect x="40" y="60" width="80" height="60" fill="#FFFFFF" stroke="#E8E8E8" stroke-width="2"/>
    <text x="80" y="135" font-family="Arial" font-size="11" fill="#999" text-anchor="middle">#FFFFFF</text>
  </g>
  <g>
    <rect x="140" y="60" width="80" height="60" fill="#F8F8F8"/>
    <text x="180" y="135" font-family="Arial" font-size="11" fill="#999" text-anchor="middle">#F8F8F8</text>
  </g>
  <g>
    <rect x="240" y="60" width="80" height="60" fill="#6B8E23"/>
    <text x="280" y="135" font-family="Arial" font-size="11" fill="#FFF" text-anchor="middle">#6B8E23</text>
  </g>
  <g>
    <rect x="340" y="60" width="80" height="60" fill="#8AB84F"/>
    <text x="380" y="135" font-family="Arial" font-size="11" fill="#FFF" text-anchor="middle">#8AB84F</text>
  </g>
  <g>
    <rect x="440" y="60" width="80" height="60" fill="#1A1A1A"/>
    <text x="480" y="135" font-family="Arial" font-size="11" fill="#FFF" text-anchor="middle">#1A1A1A</text>
  </g>
  <text x="300" y="200" font-family="Arial" font-size="12" fill="#4D4D4D" text-anchor="middle">Spacing Grid: 8px scale</text>
  <g>
    <rect x="100" y="230" width="8" height="8" fill="#6B8E23"/>
    <text x="115" y="236" font-family="Arial" font-size="10" fill="#999">4px (xs)</text>
  </g>
  <g>
    <rect x="200" y="230" width="16" height="16" fill="#6B8E23"/>
    <text x="225" y="239" font-family="Arial" font-size="10" fill="#999">8px (sm)</text>
  </g>
  <g>
    <rect x="300" y="230" width="32" height="32" fill="#6B8E23"/>
    <text x="340" y="248" font-family="Arial" font-size="10" fill="#999">16px (md)</text>
  </g>
</svg>
