<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#6B8E23;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5A7A1F;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#grad3)"/>
  <g opacity="0.2">
    <rect x="150" y="100" width="500" height="350" fill="#FFFFFF" rx="10"/>
    <rect x="200" y="140" width="400" height="60" fill="#FFFFFF" rx="4"/>
    <rect x="200" y="230" width="400" height="60" fill="#FFFFFF" rx="4"/>
    <rect x="200" y="320" width="200" height="50" fill="#FFFFFF" rx="4"/>
  </g>
  <text x="400" y="550" font-family="Arial" font-size="28" fill="#FFFFFF" text-anchor="middle" font-weight="bold">E-commerce Checkout</text>
</svg>
