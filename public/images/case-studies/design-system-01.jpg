<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <rect width="600" height="400" fill="#FFFFFF"/>
  <text x="300" y="30" font-family="Arial" font-size="16" fill="#4D4D4D" text-anchor="middle" font-weight="bold">Components Library</text>
  <g>
    <rect x="40" y="60" width="120" height="80" fill="#6B8E23" rx="4"/>
    <rect x="180" y="60" width="120" height="80" fill="#6B8E23" rx="20"/>
    <rect x="320" y="60" width="120" height="80" fill="none" stroke="#6B8E23" stroke-width="2" rx="4"/>
    <rect x="460" y="60" width="120" height="80" fill="#6B8E23" opacity="0.3" rx="4"/>
  </g>
  <g>
    <rect x="40" y="170" width="120" height="80" fill="#8AB84F" rx="4"/>
    <rect x="180" y="170" width="120" height="80" fill="#8AB84F" rx="20"/>
    <rect x="320" y="170" width="120" height="80" fill="none" stroke="#8AB84F" stroke-width="2" rx="4"/>
    <rect x="460" y="170" width="120" height="80" fill="#8AB84F" opacity="0.3" rx="4"/>
  </g>
  <g>
    <rect x="40" y="280" width="120" height="80" fill="#5A7A1F" rx="4"/>
    <rect x="180" y="280" width="120" height="80" fill="#5A7A1F" rx="20"/>
    <rect x="320" y="280" width="120" height="80" fill="none" stroke="#5A7A1F" stroke-width="2" rx="4"/>
    <rect x="460" y="280" width="120" height="80" fill="#5A7A1F" opacity="0.3" rx="4"/>
  </g>
</svg>
