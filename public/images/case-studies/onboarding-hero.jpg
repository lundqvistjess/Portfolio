  <rect width="800" height="600" fill="url(#grad1)"/>
  <circle cx="200" cy="150" r="60" fill="#6B8E23" opacity="0.3"/>
  <circle cx="700" cy="500" r="80" fill="#6B8E23" opacity="0.2"/>
